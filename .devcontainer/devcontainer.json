{
  "name": "Premium Sync (.NET 10)",
  "image": "mcr.microsoft.com/devcontainers/dotnet:1-10.0",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },
  "forwardPorts": [5001, 5002],
  "portsAttributes": {
    "5001": { "label": "Policy Service" },
    "5002": { "label": "Billing Service" }
  },
  "postCreateCommand": "dotnet restore && dotnet build",
  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit", "humao.rest-client", "qwtel.sqlite-viewer"]
    }
  }
}
